# Copy to .env and fill in real values before `docker-compose up -d`.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=clouddb
# Comma-separated id:secret pairs to seed on api startup, e.g. my-cluster:super-secret
REGISTER_CLUSTERS=
# Seconds a successful cluster auth is cached before re-verifying (default 300).
AUTH_CACHE_SECONDS=300
# Set to true ONLY when the API runs behind exactly one trusted reverse proxy.
# Then rate limiting keys on the real client IP (HTTP: req.ip via trust proxy=1;
# WS: the rightmost X-Forwarded-For entry). Leave false for direct exposure.
# REQUIRED: the proxy must itself set/append X-Forwarded-For with the real client
# (nginx: `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`). Do NOT
# enable this behind a proxy that passes the client's header through unmodified —
# the client could then spoof the header and evade rate limiting.
TRUST_PROXY=false
